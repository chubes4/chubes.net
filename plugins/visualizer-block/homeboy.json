{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "package_excludes": [
          "/src"
        ]
      }
    }
  },
  "id": "visualizer-block",
  "remote_path": "wp-content/plugins/visualizer-block",
  "version_targets": [
    {
      "file": "visualizer-block.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "visualizer-block.php",
      "pattern": "const VERSION = '([0-9.]+)'"
    },
    {
      "file": "package.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ]
}
