{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "create-block/poem-block",
    "version": "0.1.1",
    "title": "Poem Block",
    "category": "text",
    "icon": "smiley",
    "description": "A poem split into pages, one stanza at a time, with previous/next navigation.",
    "supports": {
        "html": false,
        "inserter": true,
        "reusable": true
    },
    "textdomain": "poem-block",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js"
}
