{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "id": "poem-block",
  "remote_path": "wp-content/plugins/poem-block",
  "version_targets": [
    {
      "file": "my-first-block.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "src/block.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    },
    {
      "file": "package.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ]
}
